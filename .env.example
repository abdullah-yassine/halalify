# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=replace-with-a-real-generated-secret
DEBUG=False
ALLOWED_HOSTS=yourdomain.railway.app

# PostgreSQL (provided by Railway)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis (provided by Railway)
REDIS_URL=redis://default:password@host:6379

# Apple Sign In
APPLE_APP_BUNDLE_ID=com.yourname.halalify
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
# Path to your AuthKey_XXXXXXXXXX.p8 downloaded from developer.apple.com
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
