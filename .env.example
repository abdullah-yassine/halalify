# Copy to backend/.env and fill in real values. Never commit .env.

# Django core
SECRET_KEY=replace-with-a-real-generated-secret
DEBUG=False
ALLOWED_HOSTS=yourdomain.railway.app

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis (Railway provides REDIS_URL automatically — wired in v2 for caching)
# REDIS_URL=redis://default:password@host:6379

# Transport security (True in production, False in local dev)
SECURE_SSL_REDIRECT=True

# CORS — add your production domain if a web surface ever exists
CORS_ALLOWED_ORIGINS=

# Apple Sign In
APPLE_APP_BUNDLE_ID=com.yourname.halalify
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
# Path to AuthKey_XXXXXXXXXX.p8 from developer.apple.com
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
